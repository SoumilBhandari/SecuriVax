# Copy to backend/.env for local dev. Never commit real values.

# SQLite locally; Render injects a postgres:// URL in the cloud.
DATABASE_URL=sqlite:///./vialtality.db

# Shared secret the ESP32 nodes / simulator send in the X-Node-Key header.
NODE_KEY=dev-node-key

# Gemini names places along the route using Google Maps grounding.
# Leave blank to show coordinates instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Grok writes the plain-language report. Leave blank to use a template.
XAI_API_KEY=
GROK_MODEL=grok-4.6

# Comma-separated origins allowed to call the API (only needed when the web
# app is served from a different origin, e.g. the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Fill a fresh database with a few days of demo trips (set false for real use).
DEMO_HISTORY=true

# Weather comes from Open-Meteo (free, no key). Set true to use the built-in
# climate model instead, e.g. with no internet at the venue.
WEATHER_OFFLINE=false

# Site code for custody changes, VVM checks and dispatch decisions. The web app
# asks for it once per device. Leave empty in development.
OPERATOR_TOKEN=
