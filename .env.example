# Copy to backend/.env for local dev. Never commit real values.

# SQLite locally; Render injects a postgres:// URL in the cloud.
DATABASE_URL=sqlite:///./coldtrace.db

# Shared secret the ESP32 nodes / simulator send in the X-Node-Key header.
NODE_KEY=dev-node-key

# Gemini explains verdicts. Leave blank to use the built-in template fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated origins allowed to call the API (only needed when the web
# app is served from a different origin, e.g. the Vite dev server).
CORS_ORIGINS=http://localhost:5173
