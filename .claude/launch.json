{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && VVM_SAVE_DIR=../vvm-photos .venv/bin/uvicorn app.main:app --reload --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev:phone"
      ],
      "port": 5173
    },
    {
      "name": "prod-smoke",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "npm --prefix web run build >/dev/null && cd backend && rm -f smoke.db && DATABASE_URL=sqlite:///./smoke.db STATIC_DIR=../web/dist OPERATOR_TOKEN=smoke-test VERSION=smoke .venv/bin/uvicorn app.main:app --port 8010"
      ],
      "port": 8010
    },
    {
      "name": "web-plain",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
